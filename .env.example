# POSH Grievance Platform — environment configuration
# Copy to .env and set real values before running outside local development.

# MongoDB Atlas connection string (required for production persistence).
# If omitted, the server falls back to a local JSON file store.
MONGODB_URI=
MONGODB_DB_NAME=posh_platform

# HTTP port for the Express server
PORT=5001

# Secret used to sign JWT session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session token lifetime (accepts values like 24h, 7d)
JWT_EXPIRES_IN=24h

# Base URL of the running app — used to build password-reset links
APP_BASE_URL=http://localhost:5173

# Maximum evidence file size in bytes (10 MB)
MAX_FILE_SIZE=10485760
