# POSH Grievance Platform — environment configuration
# Copy to .env and set real values before running outside local development.

# MongoDB Atlas connection string (required for production persistence).
# If omitted, the server falls back to a local JSON file store.
MONGODB_URI=
MONGODB_DB_NAME=posh_platform

# HTTP port for the Express server
PORT=5001

# Secret used to sign JWT session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session token lifetime (accepts values like 24h, 7d)
JWT_EXPIRES_IN=24h

# Base URL of the running app — used to build password-reset links
APP_BASE_URL=http://localhost:5173

# Maximum evidence file size in bytes (10 MB)
MAX_FILE_SIZE=10485760

# ── Email (Google Workspace SMTP) ──────────────────────────────────────────
# Mailbox that sends every portal message. `vposh@vitap.ac.in` must have
# 2-Step Verification switched on, and SMTP_PASS must be a 16-character Google
# App Password (Google Account → Security → App passwords) — never the account
# password. If the App passwords page reports "not available for your account",
# either 2SV is off or the VIT-AP Workspace admin has disabled app passwords.
SMTP_USER=vposh@vitap.ac.in
SMTP_PASS=
# Override only when relaying through a non-Gmail SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Display name recipients see in their inbox
SMTP_FROM_NAME=V-POSH ICC · VIT-AP
# From address (defaults to SMTP_USER) and Reply-To (defaults to SMTP_USER)
SMTP_FROM=
SMTP_REPLY_TO=

# ICC mailbox that receives new-complaint and SLA-breach copies
ICC_NOTIFICATION_EMAIL=vposh@vitap.ac.in

# Master switches for the transactional email layer
EMAIL_ENABLED=true
# true = render and console-log messages instead of sending them (safe demos)
EMAIL_DRY_RUN=false
# Keep a delivery record in the `email_log` collection for statutory purposes
EMAIL_LOG_ENABLED=true
# Comma-separated service keys to silence — see the README catalogue
# e.g. EMAIL_SERVICES_DISABLED=sla_warning,feedback_request
EMAIL_SERVICES_DISABLED=
# Base URL used for deep links inside emails (defaults to APP_BASE_URL)
EMAIL_LINK_BASE_URL=
# Gmail throttles burst senders — keep a gap between sends, retry transient 4xx
EMAIL_MIN_SEND_GAP_MS=300
EMAIL_SEND_ATTEMPTS=2

# ── KratosID passwordless auth (push + QR sign-in) ─────────────────────────
# Values come from the KratosID dashboard. On Vercel these MUST be set in
# Project → Settings → Environment Variables: .env is gitignored and is not
# deployed with the repo, so without them every Kratos route fails.
KRATOSID_API_KEY=
KRATOSID_PRODUCT_ID=
# Production host. Note: api.kratosid.com does NOT resolve — use api-prod.
KRATOSID_BASE_URL=https://api-prod.kratosid.com
# Label shown on the user's mobile approval prompt
KRATOSID_APP_NAME=vposh

# ── Google OAuth (student / faculty SSO) ──────────────────────────────────
# GOOGLE_CLIENT_ID is used server-side to verify tokens; the VITE_ copy is
# compiled into the client bundle at build time.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
