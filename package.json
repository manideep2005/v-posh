{
  "name": "posh-complaint-platform",
  "version": "1.0.0",
  "description": "Institutional POSH Awareness and Complaint Management System",
  "main": "server/index.js",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev -w client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build -w client",
    "build:client": "npm run build -w client",
    "seed": "node server/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
